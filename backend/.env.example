# URL de tu proyecto de Supabase (Project Settings -> API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# service_role key (Project Settings -> API -> service_role)
# OJO: esta clave es secreta, nunca la subas a un repo público
# ni la uses en el frontend.
SUPABASE_SERVICE_KEY=tu-service-role-key

# Radio por defecto (en km) para considerar "cercano" a un usuario
DEFAULT_RADIUS_KM=3
